generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model detection_history {
  id                BigInt      @id @default(autoincrement())
  vehicle_id        BigInt?
  reader_id         BigInt?
  detected_at       DateTime?   @default(now()) @db.Timestamp(6)
  compliance_status String      @db.VarChar(50)
  violation_details String?
  created_at        DateTime?   @default(now()) @db.Timestamp(6)
  fix_reader        fix_reader? @relation(fields: [reader_id], references: [id], onUpdate: NoAction, map: "fk_detection_fix_reader")
  vehicle           vehicle?    @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction, map: "fk_detection_vehicle")

  @@index([compliance_status], map: "idx_detection_status")
  @@index([detected_at], map: "idx_detection_timestamp")
  @@index([vehicle_id], map: "idx_detection_vehicle")
}

model document {
  id               BigInt         @id @default(autoincrement())
  vehicle_id       BigInt?
  document_type_id BigInt?
  reference_number String?        @db.VarChar(100)
  start_date       DateTime?      @db.Timestamp(6)
  end_date         DateTime?      @db.Timestamp(6)
  image_url        String?        @db.VarChar(500)
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  updated_at       DateTime?      @default(now()) @db.Timestamp(6)
  document_type    document_type? @relation(fields: [document_type_id], references: [id], onUpdate: NoAction, map: "fk_document_document_type")
  vehicle          vehicle?       @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_vehicle")

  @@index([end_date], map: "idx_document_end_date")
  @@index([vehicle_id], map: "idx_document_vehicle")
}

model document_type {
  id          BigInt     @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  description String?    @db.VarChar(255)
  document    document[]
}

model fix_reader {
  id                BigInt              @id @default(autoincrement())
  name              String              @db.VarChar(100)
  serial_number     String?             @db.VarChar(100)
  model             String?             @db.VarChar(100)
  location          String?             @db.VarChar(255)
  ip_address        String?             @db.VarChar(45)
  is_active         Boolean             @default(true)
  scan_center_id    BigInt?
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  detection_history detection_history[]
  scan_center       scan_center?        @relation(fields: [scan_center_id], references: [id], onUpdate: NoAction, map: "fk_fix_reader_scan_center")
}

model flyway_schema_history {
  installed_rank Int      @id(map: "flyway_schema_history_pk")
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(6)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
}

model role {
  id          BigInt  @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)
  users       users[]
}

model scan_center {
  id         BigInt       @id @default(autoincrement())
  name       String       @db.VarChar(100)
  location   Json?
  city       String?      @db.VarChar(100)
  district   String?      @db.VarChar(100)
  province   String?      @db.VarChar(100)
  is_active  Boolean      @default(true)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  updated_at DateTime?    @default(now()) @db.Timestamp(6)
  fix_reader fix_reader[]
  users      users[]
}

model users {
  id             BigInt       @id @default(autoincrement())
  username       String       @unique @db.VarChar(100)
  email          String       @unique @db.VarChar(100)
  password       String       @db.VarChar(255)
  first_name     String?      @db.VarChar(100)
  last_name      String?      @db.VarChar(100)
  role_id        BigInt?
  contact_number String?      @db.VarChar(20)
  nic            String?      @db.VarChar(20)
  district       String?      @db.VarChar(100)
  province       String?      @db.VarChar(100)
  scan_center_id BigInt?
  created_at     DateTime?    @default(now()) @db.Timestamp(6)
  updated_at     DateTime?    @default(now()) @db.Timestamp(6)
  role           role?        @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "fk_users_role")
  scan_center    scan_center? @relation(fields: [scan_center_id], references: [id], onUpdate: NoAction, map: "fk_users_scan_center")
  vehicle        vehicle[]

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
}

model vehicle {
  id                  BigInt              @id @default(autoincrement())
  vehicle_type_id     BigInt?
  vehicle_model_id    BigInt?
  owner_id            BigInt?
  registration_number String              @unique @db.VarChar(100)
  vehicle_number      String?             @db.VarChar(100)
  chassis_number      String?             @db.VarChar(100)
  epc                 String              @unique @db.VarChar(100)
  registered_year     Int?
  created_at          DateTime?           @default(now()) @db.Timestamp(6)
  updated_at          DateTime?           @default(now()) @db.Timestamp(6)
  detection_history   detection_history[]
  document            document[]
  users               users?              @relation(fields: [owner_id], references: [id], onUpdate: NoAction, map: "fk_vehicle_owner")
  vehicle_model       vehicle_model?      @relation(fields: [vehicle_model_id], references: [id], onUpdate: NoAction, map: "fk_vehicle_vehicle_model")
  vehicle_type        vehicle_type?       @relation(fields: [vehicle_type_id], references: [id], onUpdate: NoAction, map: "fk_vehicle_vehicle_type")

  @@index([epc], map: "idx_vehicle_epc")
  @@index([owner_id], map: "idx_vehicle_owner")
  @@index([registration_number], map: "idx_vehicle_registration")
}

model vehicle_make {
  id            BigInt          @id @default(autoincrement())
  name          String          @unique @db.VarChar(100)
  description   String?
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @db.Timestamp(6)
  vehicle_model vehicle_model[]
}

model vehicle_model {
  id           BigInt        @id @default(autoincrement())
  name         String        @db.VarChar(100)
  make_id      BigInt?
  description  String?
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  updated_at   DateTime?     @default(now()) @db.Timestamp(6)
  vehicle      vehicle[]
  vehicle_make vehicle_make? @relation(fields: [make_id], references: [id], onUpdate: NoAction, map: "fk_vehicle_model_make")
}

model vehicle_type {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  zpl_code    String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  vehicle     vehicle[]
}
